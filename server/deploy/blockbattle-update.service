# One update check. Started by blockbattle-update.timer; see SERVER_SETUP.md.
# Runs as root so it can restart the server; git and npm run as whoever owns the repo.
# Change the path below if your repo isn't in /home/zamanarvin/BlockBattle.

[Unit]
Description=BlockBattle auto-update check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /home/zamanarvin/BlockBattle/server/deploy/autoupdate.sh
Environment=BRANCH=main
