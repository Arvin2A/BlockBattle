# Checks GitHub for new commits every 5 minutes. See SERVER_SETUP.md.
# Install:  sudo cp server/deploy/blockbattle-update.* /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now blockbattle-update.timer

[Unit]
Description=Check for BlockBattle updates every 5 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min

[Install]
WantedBy=timers.target
